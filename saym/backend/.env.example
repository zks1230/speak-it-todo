## 说一嘴后端启动配置（D13：鸡生蛋问题，不能进 DB）
## 复制此文件为 .env 后修改。也可全部改成环境变量，环境变量优先级高于此文件。
## 用 `./gradlew :backend:run --args="hashPwd 你的密码"` 生成主密码哈希和 AES 密钥。

## Neon（Serverless PostgreSQL）连接串
NEON_JDBC_URL=jdbc:postgresql://ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
NEON_USER=neondb_owner
NEON_PASSWORD=xxxxxxxx

## AES-256 密钥（任意 32+ 字符随机串，用于 DB 内敏感字段加密；改后旧密文无法解密）
SAYM_CONFIG_KEY=please-replace-me-with-48-random-chars

## 主密码 bcrypt 哈希（用 hashPwd 命令生成）
SAYM_MASTER_HASH=$2a$10$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

## 可选
# SAYM_PORT=8080
# SAYM_BIND_ADDR=0.0.0.0
# SAYM_DB_POOL=5
# SAYM_DEFAULT_DEVICE_ID=phone-abc123
